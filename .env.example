# ─────────────────────────────────────────────────────────────
# ARMONY · Variables de entorno
# Copiar como .env.local y completar. NUNCA subir .env.local al repo.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. No exponer jamás en el cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Remitente verificado en Resend, ej: ARMONY <contacto@tudominio.cl>
RESEND_FROM_EMAIL=
# Correo interno que recibe las nuevas solicitudes
ADMIN_NOTIFICATION_EMAIL=

# Contacto público
# Formato internacional sin signos, ej: 56912345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# URL pública del sitio (para canonical, sitemap y OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.armony.cl

# Analítica (opcional: si están vacías, no se carga ningún script)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
